# OnOffDash V2 - Windows Agent Environment Template
# Copy to .env in the agent execution directory

# Backend Server URL (without trailing slash)
# If communicating through Nginx reverse proxy: http://<SERVER_IP>
# If communicating directly with Express backend: http://<SERVER_IP>:3001
SERVER_URL=http://localhost:3001

# Shared Agent API Key (Must match AGENT_API_KEY on the backend)
AGENT_API_KEY=ReplaceWithSecureAgentKeyMin32Chars!

# Intervals (in milliseconds)
# Heartbeat telemetry: default 30000 (30 seconds)
HEARTBEAT_INTERVAL=30000

# Software inventory scan: default 21600000 (6 hours)
SOFTWARE_INTERVAL=21600000

# Auto-update check: default 21600000 (6 hours)
UPDATE_CHECK_INTERVAL=21600000
