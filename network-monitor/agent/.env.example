# OnOffDash V2 - Windows Agent Environment Template
# Copy to .env in the agent execution directory

# Backend Server URL (without trailing slash)
# PRODUCTION REQUIREMENT: Must use HTTPS (HTTP is rejected in production)
SERVER_URL=https://onoffdash.company.local

# LOCAL DEVELOPMENT ONLY: Set ALLOW_INSECURE_HTTP=true to allow plain HTTP in dev
# ALLOW_INSECURE_HTTP=true
# SERVER_URL=http://localhost:3001

# Per-Device Agent Access Key (Format: agk_<keyId>.<secret>)
# Generate this via Dashboard -> Devices -> Enroll Agent or POST /api/agent/enroll
# NOTE: Shared legacy AGENT_API_KEY is disabled by default on the backend.
AGENT_API_KEY=agk_0123456789abcdef.fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Intervals (in milliseconds)
# Heartbeat telemetry: default 30000 (30 seconds)
HEARTBEAT_INTERVAL=30000

# Software inventory scan: default 21600000 (6 hours)
SOFTWARE_INTERVAL=21600000

# Auto-update check: default 21600000 (6 hours)
UPDATE_CHECK_INTERVAL=21600000
