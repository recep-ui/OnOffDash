# OnOffDash V2 - Backend Environment Template
# Copy to .env and configure with secure production values

# Database Connection
DB_HOST=localhost
DB_PORT=1433
DB_NAME=network_monitor
DB_USER=sa
DB_PASSWORD=ReplaceWithStrongPassword123!

# Application Database Credentials (for non-sa runtime operation)
DB_APP_USER=app_user
DB_APP_PASSWORD=ReplaceWithAppUserPassword123!

# Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

# Security & Authentication
# JWT Secret key for token signing (Minimum 32 characters required)
JWT_SECRET=ReplaceWithSecureRandomSecretMin32CharsLength!

# Shared Agent Key for authenticating Windows Agents
AGENT_API_KEY=ReplaceWithSecureAgentKeyMin32Chars!

# Initial Admin Bootstrap (Used only if users table is empty)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithAdminPassword123!

# Scanning & Retention Intervals
PING_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=90
RETENTION_DAYS=30

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
