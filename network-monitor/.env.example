# OnOffDash V2 - Docker Environment Template
# Copy to .env and configure with secure production values

# --- Database Configuration ---
# SA password for MSSQL Server initialization (min 8 chars, mixed case, numbers, symbols)
MSSQL_SA_PASSWORD=ReplaceWithStrongPassword123!
DB_NAME=network_monitor
DB_USER=sa

# Application Database User (Runtime least-privilege account)
DB_APP_USER=app_user
DB_APP_PASSWORD=ReplaceWithAppUserPassword123!

# --- Security & Authentication ---
# Asymmetric RSA Keypair (Mandatory in production mode RS256)
# Backend requires private and public keys. Python microservices require public key only.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# Internal Microservice Introspection Secret (Required for inter-service token validation)
AUTH_INTROSPECTION_SECRET=ReplaceWithSecureInternalSecretMin32CharsLength!

# Development / Test Symmetric Secret (Prohibited in production mode)
# JWT_SECRET=OnlyUsedInTestOrDevelopmentModeMin32Chars!

# Agent Authentication
# Standard: Per-device hashed credentials (agk_<keyId>.<secret>) enrolled per device
# Legacy shared key is DISABLED by default. Set ALLOW_LEGACY_AGENT_AUTH=true only for temporary migration.
ALLOW_LEGACY_AGENT_AUTH=false
AGENT_API_KEY=OptionalLegacyAgentKeyMin32CharsIfAllowed!

# Initial Admin Bootstrap (Only used if users table is completely empty)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithAdminPassword123!

# --- Monitoring & Scanning Settings ---
PING_INTERVAL_SECONDS=60
PING_CONCURRENCY=25
HEARTBEAT_TIMEOUT_SECONDS=90
RETENTION_DAYS=30

# --- Printer & SNMP Monitoring ---
# Required in production: SNMP community string (do NOT use "public" in production)
SNMP_COMMUNITY=ReplaceWithSecureSnmpCommunityString
SNMP_VERSION=1
LOW_TONER_THRESHOLD_PERCENT=10
PRINTER_SCAN_CONCURRENCY=5

# --- IPAM Configuration ---
DEFAULT_SUBNET_PREFIX=10.0.80

# --- Ports & Networking ---
# Host port published for Nginx reverse proxy (HTTP)
HOST_PORT=80

# Comma-separated list of allowed CORS origins (mandatory in production; wildcards forbidden)
CORS_ORIGINS=http://localhost,http://localhost:80

# --- Microservices File Limits ---
MAX_FILE_SIZE_MB=50
FILE_TOOLS_MAX_FILE_SIZE_MB=50
FILE_TOOLS_TTL_MINUTES=60
FILE_TOOLS_LOG_MODE=jsonl
