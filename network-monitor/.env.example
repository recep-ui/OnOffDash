# OnOffDash V2 - Docker Çevre Değişkenleri Şablonu

# --- Veritabanı Yapılandırması ---
# Microsoft SQL Server (sa) kullanıcısı için şifre. Şifrenin en az 8 karakter, büyük/küçük harf, rakam ve özel karakter içermesi gerekir.
MSSQL_SA_PASSWORD=StrongPassword123!
DB_NAME=network_monitor
DB_USER=sa

# --- Sunucu Yapılandırması ---
# JWT Token üretimi ve doğrulaması için kullanılacak gizli anahtar.
JWT_SECRET=on-off-dash-secret-key-2026

# Sunucu tarama ve zaman aşımı ayarları (saniye)
PING_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=90

# Eski log ve veri saklama süresi (gün)
RETENTION_DAYS=30

# --- Frontend & Mikroservis Portları ---
# Dış dünyaya açılacak ana HTTP portu (Varsayılan: 80)
HOST_PORT=80

# PDF ve Dosya mikroservisleri için izin verilen CORS origin listesi (Virgülle ayrılmış)
CORS_ORIGINS=http://localhost,http://localhost:80

# Mikroservis dosya yükleme limitleri (Megabayt)
MAX_FILE_SIZE_MB=50
FILE_TOOLS_MAX_FILE_SIZE_MB=50
FILE_TOOLS_TTL_MINUTES=60
FILE_TOOLS_LOG_MODE=jsonl
