# Optional Docker Compose Override for Local Development and Debugging
# Copy this file to `docker-compose.override.yml` if you want to expose
# internal container ports directly to your host machine for local development.
#
# DO NOT use in production.

services:
  db:
    ports:
      - "1433:1433"

  backend:
    ports:
      - "3001:3001"

  pdf-service:
    ports:
      - "8001:8001"

  file-service:
    ports:
      - "8002:8002"
